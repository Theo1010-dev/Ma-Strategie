{
  "name": "Ma stratégie",
  "short_name": "Ma stratégie",
  "description": "Ton plan PEA, mois après mois : quoi acheter, quand, et pourquoi.",
  "lang": "fr",
  "id": "./",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#E8EEEB",
  "theme_color": "#14302A",
  "categories": ["finance", "productivity"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Mon ordre du mois", "short_name": "Mon ordre", "url": "./?tab=home", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Mon portefeuille", "short_name": "Portefeuille", "url": "./?tab=pf", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Calendrier", "short_name": "Calendrier", "url": "./?tab=cal", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "files": [{ "name": "image", "accept": ["image/png", "image/jpeg", "image/webp"] }] }
  }
}
